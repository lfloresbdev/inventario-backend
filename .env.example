# ─────────────────────────────────────────────────────────────────
# Variables requeridas en producción.
# Copiar como .env (nunca commitear .env con valores reales).
# En local estas variables ya tienen defaults seguros para desarrollo.
# ─────────────────────────────────────────────────────────────────

# Perfil activo: "dev" (local) o "prod" (producción)
SPRING_PROFILES_ACTIVE=prod

# JWT — mínimo 32 caracteres aleatorios, nunca reutilizar entre ambientes
JWT_SECRET=cambia-esto-por-un-secret-aleatorio-de-32-o-mas-caracteres

# Cifrado de campos sensibles (contraseñas de InventarioLogico)
# Cambiar este secret invalida todos los registros cifrados existentes
ENCRYPT_SECRET=cambia-esto-por-otro-secret-aleatorio-distinto-al-jwt

# Contraseñas de usuarios iniciales — cambiar inmediatamente después del primer deploy
SEED_ADMIN_PASSWORD=password-admin-seguro
SEED_USER_PASSWORD=password-user-seguro

# Base de datos PostgreSQL (requerido en prod)
DB_URL=jdbc:postgresql://localhost:5432/inventario
DB_USER=inventario_user
DB_PASSWORD=password-de-base-de-datos-seguro

# Cookie httpOnly — true en producción (HTTPS), false en local (HTTP)
COOKIE_SECURE=true

# Origen permitido para CORS — URL del frontend en producción
CORS_ALLOWED_ORIGIN=https://tu-dominio.com
